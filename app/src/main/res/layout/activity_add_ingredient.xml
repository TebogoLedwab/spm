<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent" xmlns:app="http://schemas.android.com/apk/res-auto">

    <ImageView
            android:id="@+id/btn_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="20dp"
            android:contentDescription="@string/go_back"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintBottom_toBottomOf="@+id/tv_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_title"
            app:tint="#3D2954" />

    <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:text="@string/add_ingredient"
            android:textColor="#3D2954"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btn_back"
            app:layout_constraintTop_toTopOf="parent" />

    <TextView
            android:id="@+id/lbl_ingredient_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginStart="20dp"
            android:text="@string/ingredient_name"
            android:textColor="@color/primary"
            android:textSize="14sp"
            android:labelFor="@id/til_ingredient_name"
            app:layout_constraintTop_toBottomOf="@+id/tv_title" />

    <EditText
            android:id="@+id/til_ingredient_name"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="5dp"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:autofillHints=""
            android:background="@drawable/edit_text_border"
            android:inputType="text"
            android:paddingHorizontal="12dp"
            app:layout_constraintTop_toBottomOf="@id/lbl_ingredient_name"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    <TextView
            android:id="@+id/lbl_quantity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:text="@string/quantity"
            android:textColor="@color/primary"
            android:textSize="14sp"
            android:labelFor="@id/et_quantity"
            app:layout_constraintEnd_toStartOf="@+id/lbl_unit"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/til_ingredient_name" />

    <EditText
            android:id="@+id/et_quantity"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="8dp"
            android:layout_marginStart="18dp"
            android:autofillHints=""
            android:background="@drawable/edit_text_border"
            android:inputType="number"
            android:paddingHorizontal="12dp"
            android:textColor="#333333"
            app:layout_constraintEnd_toStartOf="@+id/layout_unit_dropdown"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lbl_quantity" />

    <TextView
            android:id="@+id/lbl_unit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/unit"
            android:textColor="#3D2954"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="@+id/lbl_quantity"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/lbl_quantity"
            app:layout_constraintTop_toTopOf="@+id/lbl_quantity" />

    <include
            android:id="@+id/layout_unit_dropdown"
            layout="@layout/activity_custom_dropdown"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintBottom_toBottomOf="@+id/et_quantity"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/et_quantity"
            app:layout_constraintTop_toTopOf="@+id/et_quantity" />

    <TextView
            android:id="@+id/lbl_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginStart="16dp"
            android:text="@string/category"
            android:textColor="@color/primary"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@+id/et_quantity" />

    <include
            android:id="@+id/layout_category_dropdown"
            layout="@layout/activity_custom_dropdown"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            app:layout_constraintTop_toBottomOf="@+id/lbl_category" />

    <TextView
            android:id="@+id/lbl_expiry_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginStart="18dp"
            android:text="@string/expiry_date"
            android:textColor="@color/primary"
            android:textSize="14sp"
            android:labelFor="@id/et_expiry_date"
            app:layout_constraintTop_toBottomOf="@+id/layout_category_dropdown" />

    <EditText
            android:id="@+id/et_expiry_date"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="5dp"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:autofillHints=""
            android:background="@drawable/edit_text_border"
            android:clickable="true"
            android:focusable="false"
            android:inputType="datetime"
            android:hint="@string/select_date"
            android:paddingHorizontal="12dp"
            android:textColor="#333333"
            app:layout_constraintTop_toBottomOf="@id/lbl_expiry_date" />

    <TextView
            android:id="@+id/tv_helper_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="18dp"
            android:text="@string/please_select_a_future_date"
            android:textColor="#666666"
            android:textSize="12sp"
            app:layout_constraintTop_toBottomOf="@+id/et_expiry_date" />
    <!-- Action Buttons Group -->
    <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="3dp"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:text="@string/save"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#3D2954"
            app:cornerRadius="12dp"
            app:layout_constraintBottom_toTopOf="@+id/btn_delete" />

    <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_delete"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:layout_marginBottom="50dp"
            android:text="@string/delete"
            android:textAllCaps="false"
            android:textColor="#3D2954"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:strokeColor="#3D2954"
            app:strokeWidth="1dp"
            app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>