<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
                                                   xmlns:app="http://schemas.android.com/apk/res-auto"
                                                   xmlns:tools="http://schemas.android.com/tools"
                                                   android:layout_width="match_parent"
                                                   android:layout_height="match_parent">

    <Button
            android:text="@string/sign_in"
            android:layout_width="300dp"
            android:layout_height="wrap_content" android:id="@+id/signin"
            android:layout_marginEnd="2dp"
            android:layout_marginBottom="9dp" app:layout_constraintEnd_toEndOf="@+id/signup"
            app:layout_constraintBottom_toTopOf="@+id/signup" app:rippleColor="#2196F3"/>
    <Button
            android:text="@string/sign_up"
            android:layout_width="300dp"
            android:layout_height="wrap_content" android:id="@+id/signup"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" android:layout_marginBottom="23dp"
            app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>